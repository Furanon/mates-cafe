---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';
import { Image } from 'astro:assets';
import groupshot from '@images/groupshot.png';
import splash from '@images/splash.jpeg';
import table1 from '@images/table.jpeg';
import table2 from '@images/table2.jpeg';
import table3 from '@images/table3.jpeg';
import type { WithContext, Thing } from 'schema-dts';
import { absoluteUrl } from '@utils/url';

// SEO metadata for the page
const seo = {
  title: 'About MATES Cafe',
  description:
    'Learn about MATES Cafe in Tanjong Malim - a community-focused cafe with a student volunteer barista program and bi-monthly art space for local artists.',
};

// Schema.org metadata for SEO
const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: 'en-US',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'About MATES Cafe',
  description:
    'MATES Cafe in Tanjong Malim, Perak - Community-focused cafe with student volunteer barista program and bi-monthly art space.',
  isPartOf: {
    '@type': 'WebSite',
    url: absoluteUrl('/'),
    name: 'MATES',
    description:
      'MATES is a community-focused cafe in Tanjong Malim, Malaysia, where students learn barista skills through a volunteering program. We also host an art space twice a month for local artists and craftspeople.',
  },
};
---

<BaseLayout seo={seo} schema={schema}>
  {/* Hero Section */}
  <section class="mx-auto max-w-[85rem] px-4 pt-48 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-light text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl">
          Our Story
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-lg font-medium text-pretty text-slate-700 sm:text-xl/8">
          MATES began with a simple idea: what if a cafe could be more than just
          a place to get coffee? What if it could be a place where people learn,
          create, and connect?
        </p>
      </div>
    </div>
  </section>

  {/* Mission Section */}
  <section
    id="mission"
    class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8"
  >
    <div class="mx-auto max-w-5xl">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-semibold text-balance text-slate-800">
            Community First, Always
          </h2>
          <p class="mt-6 text-lg text-pretty text-slate-600">
            Located in the heart of Tanjong Malim, Perak, MATES was founded on
            the belief that great coffee tastes even better when shared with
            good company. Our space is designed to be a warm, welcoming third
            place – not home, not work, but somewhere in between where everyone
            feels at home.
          </p>
          <p class="mt-4 text-lg text-pretty text-slate-600">
            From students studying for exams to artists preparing for our next
            exhibition, from families enjoying weekend brunch to remote workers
            finding their flow – MATES is where the community comes together.
          </p>
        </div>
        <div class="relative">
          <Image
            src={table1}
            alt="MATES Cafe interior - cozy seating area"
            width={800}
            height={600}
            class="rounded-2xl shadow-xl w-full h-auto"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Volunteer Program Section */}
  <section
    id="volunteer"
    class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8 bg-matcha-50/30"
  >
    <div class="mx-auto max-w-5xl">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="relative order-2 lg:order-1">
          <Image
            src={groupshot}
            alt="MATES student volunteers learning barista skills"
            width={800}
            height={600}
            class="rounded-2xl shadow-xl w-full h-auto"
          />
        </div>
        <div class="order-1 lg:order-2">
          <h2 class="text-3xl font-semibold text-balance text-slate-800">
            Student Volunteer Program
          </h2>
          <p class="mt-6 text-lg text-pretty text-slate-600">
            One of the things that makes MATES truly special is our student
            volunteer program. We partner with local schools and universities to
            offer students a unique opportunity: volunteer your time at the
            cafe, and in return, learn professional barista skills from our
            experienced team.
          </p>
          <p class="mt-4 text-lg text-pretty text-slate-600">
            Students learn everything from espresso extraction and milk steaming
            to latte art and customer service. It's hands-on experience that
            builds confidence, teaches responsibility, and provides valuable
            employability skills – all while being part of a supportive
            community.
          </p>
          <ul class="mt-6 space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-matcha-600">☕</span>
              <span class="text-slate-600">Professional barista training</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-matcha-600">📜</span>
              <span class="text-slate-600">Certificate of completion</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-matcha-600">🤝</span>
              <span class="text-slate-600">Real work experience</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-matcha-600">🌱</span>
              <span class="text-slate-600">
                Mentorship from experienced baristas
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Art Space Section */}
  <section
    id="art-space"
    class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8"
  >
    <div class="mx-auto max-w-5xl">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-semibold text-balance text-slate-800">
            Bi-Monthly Art Space
          </h2>
          <p class="mt-6 text-lg text-pretty text-slate-600">
            Twice a month, we clear our walls and tables to make room for
            creativity. Our art space opens its doors to local artists, makers,
            and craftspeople to display and sell their work – no commission, no
            fees, just community support.
          </p>
          <p class="mt-4 text-lg text-pretty text-slate-600">
            From paintings and photography to ceramics, jewelry, and handmade
            crafts – each event brings something new. Visitors enjoy great
            coffee while discovering local talent, and artists get a platform to
            reach new audiences.
          </p>
          <div class="mt-6 flex gap-4">
            <Image
              src={splash}
              alt="Artwork and posters on the walls at MATES Cafe"
              width={200}
              height={150}
              class="rounded-lg shadow-md w-48 h-auto shrink-0"
            />
            <Image
              src={table2}
              alt="Art displayed at MATES Cafe"
              width={200}
              height={150}
              class="rounded-lg shadow-md w-48 h-auto shrink-0"
            />
          </div>
        </div>
        <div class="relative">
          <Image
            src={table3}
            alt="Art space setup at MATES Cafe"
            width={800}
            height={600}
            class="rounded-2xl shadow-xl w-full h-auto"
          />
        </div>
      </div>
    </div>
  </section>

  {/* Values Section */}
  <section class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8 bg-mates-blue-50/30">
    <div class="mx-auto max-w-5xl text-center">
      <h2 class="text-3xl font-semibold text-balance text-slate-800">
        Our Values
      </h2>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div class="p-6">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-matcha-100 text-matcha-700">
            <Icon name="coffee" class="text-matcha-700" />
          </div>
          <h3 class="font-semibold text-slate-800">Quality Coffee</h3>
          <p class="mt-2 text-sm text-slate-600">
            Expertly crafted with premium beans and matcha
          </p>
        </div>
        <div class="p-6">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-mates-blue-100 text-mates-blue-700">
            <Icon name="users" class="text-mates-blue-700" />
          </div>
          <h3 class="font-semibold text-slate-800">Community</h3>
          <p class="mt-2 text-sm text-slate-600">
            A welcoming space for everyone to connect
          </p>
        </div>
        <div class="p-6">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-matcha-100 text-matcha-700">
            <Icon name="palette" class="text-matcha-700" />
          </div>
          <h3 class="font-semibold text-slate-800">Creativity</h3>
          <p class="mt-2 text-sm text-slate-600">
            Supporting local artists and creative expression
          </p>
        </div>
        <div class="p-6">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-mates-blue-100 text-mates-blue-700">
            <Icon name="sprout" class="text-mates-blue-700" />
          </div>
          <h3 class="font-semibold text-slate-800">Growth</h3>
          <p class="mt-2 text-sm text-slate-600">
            Empowering students with real-world skills
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
