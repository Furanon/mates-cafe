---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import { Image } from 'astro:assets';
import groupshot from '@images/groupshot.png';
import community1 from '@images/community1.jpeg';
import table1 from '@images/table.jpeg';
import table2 from '@images/table2.jpeg';
import table3 from '@images/table3.jpeg';
import type { WithContext, Thing } from 'schema-dts';
import { site } from '@/site';

const seo = {
  title: 'Community - MATES Cafe',
  description:
    'Join the MATES Cafe community - student barista volunteer program and bi-monthly art space for local artists and craftspeople in Tanjong Malim.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: 'en-US',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'Community - MATES Cafe',
  description:
    'Student barista volunteer program and bi-monthly art space at MATES Cafe in Tanjong Malim.',
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: 'MATES',
  },
};
---

<BaseLayout seo={seo} schema={schema}>
  {/* Hero */}
  <section class="mx-auto max-w-[85rem] px-4 pt-48 pb-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-light text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl">
        More Than a Cafe
      </h1>
      <p class="mt-6 text-lg text-pretty text-slate-600">
        MATES is built on community. Two programs sit at the heart of everything
        we do – our student volunteer program and our bi-monthly art space.
      </p>
    </div>
  </section>

  {/* Groupshot hero image */}
  <section class="mx-auto max-w-[85rem] px-4 pb-16 sm:px-6 lg:px-8">
    <div class="relative mx-auto max-w-5xl">
      <Image
        src={groupshot}
        alt="MATES Cafe community - student volunteers and team"
        width={1200}
        height={800}
        class="rounded-3xl shadow-2xl w-full h-auto"
      />
      <div class="absolute inset-x-0 bottom-0 rounded-b-3xl bg-gradient-to-t from-black/70 to-transparent p-6 sm:p-10">
        <p class="text-lg font-medium text-white sm:text-xl">
          The people who make MATES feel like home.
        </p>
      </div>
    </div>
  </section>

  {/* Volunteer Program */}
  <section
    id="volunteer"
    class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8"
  >
    <div class="mx-auto max-w-5xl grid gap-12 lg:grid-cols-2 items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-matcha-600">
          For Students
        </p>
        <h2 class="mt-2 text-3xl font-semibold text-slate-800 md:text-4xl">
          Volunteer & Learn to Be a Barista
        </h2>
        <p class="mt-6 text-lg text-pretty text-slate-600">
          We believe the best way to learn is by doing. Our volunteer program
          invites students from Tanjong Malim and beyond to spend time behind
          the bar, learning real barista skills from our team.
        </p>
        <p class="mt-4 text-lg text-pretty text-slate-600">
          In exchange for your time, you'll learn how to dial in espresso, steam
          milk to the perfect texture, pour latte art, and serve customers with
          confidence. No experience necessary – just curiosity and a willingness
          to learn.
        </p>
        <ul class="mt-8 space-y-4">
          {[
            'Hands-on training in espresso, milk, and brewing',
            'Latte art practice with real customers',
            'Certificate of completion for your CV',
            'Flexible shifts around your studies',
            'A supportive team that has your back',
          ].map(item => (
            <li class="flex items-start gap-3">
              <span class="mt-1 flex size-5 shrink-0 items-center justify-center rounded-full bg-matcha-100 text-matcha-700 text-xs">
                ✓
              </span>
              <span class="text-slate-600">{item}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-lg bg-matcha-700 px-6 py-3 font-medium text-white transition-colors hover:bg-matcha-800 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-matcha-700/80 focus-visible:ring-offset-2"
          >
            Apply to Volunteer
          </a>
        </div>
      </div>
      <div>
        <Image
          src={community1}
          alt="MATES student volunteers at work"
          width={800}
          height={600}
          class="rounded-2xl shadow-xl w-full h-auto"
        />
      </div>
    </div>
  </section>

  {/* Art Space */}
  <section id="art-space" class="bg-matcha-50/40">
    <div class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-mates-blue-600">
            For Artists & Makers
          </p>
          <h2 class="mt-2 text-3xl font-semibold text-slate-800 md:text-4xl">
            The MATES Art Space
          </h2>
          <p class="mt-6 text-lg text-pretty text-slate-600">
            Twice a month, our cafe becomes a gallery and marketplace. Local
            artists, illustrators, ceramicists, jewellers, and craftspeople are
            invited to display and sell their work – free of charge.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-3">
          <div class="overflow-hidden rounded-2xl">
            <Image
              src={table2}
              alt="Art displayed at MATES Cafe"
              width={600}
              height={450}
              class="h-56 w-full object-cover"
            />
          </div>
          <div class="overflow-hidden rounded-2xl">
            <Image
              src={table3}
              alt="Art space setup at MATES Cafe"
              width={600}
              height={450}
              class="h-56 w-full object-cover"
            />
          </div>
          <div class="overflow-hidden rounded-2xl">
            <Image
              src={table1}
              alt="The MATES communal table beneath posters and artwork"
              width={600}
              height={450}
              class="h-56 w-full object-cover"
            />
          </div>
        </div>

        <div class="mt-12 grid gap-8 sm:grid-cols-3">
          <div class="rounded-2xl bg-white p-6 shadow-sm">
            <h3 class="font-semibold text-slate-800">No Fees, No Commission</h3>
            <p class="mt-2 text-sm text-slate-600">
              Artists keep 100% of what they sell. We provide the space, the
              foot traffic, and the coffee.
            </p>
          </div>
          <div class="rounded-2xl bg-white p-6 shadow-sm">
            <h3 class="font-semibold text-slate-800">Twice a Month</h3>
            <p class="mt-2 text-sm text-slate-600">
              Our art space opens on the second and fourth weekend of every
              month. Follow us on Instagram for dates.
            </p>
          </div>
          <div class="rounded-2xl bg-white p-6 shadow-sm">
            <h3 class="font-semibold text-slate-800">Everyone Welcome</h3>
            <p class="mt-2 text-sm text-slate-600">
              Entry is always free. Come support local creativity – and maybe
              take home something beautiful.
            </p>
          </div>
        </div>

        <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a
            href={site.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-matcha-700 px-6 py-3 font-medium text-white transition-colors hover:bg-matcha-800 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-matcha-700/80 focus-visible:ring-offset-2"
          >
            See Upcoming Dates on Instagram
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-lg border-2 border-matcha-700 px-6 py-3 font-medium text-matcha-800 transition-colors hover:bg-matcha-700 hover:text-white focus:outline-hidden focus-visible:ring-2 focus-visible:ring-matcha-700/80 focus-visible:ring-offset-2"
          >
            Register as an Artist
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
