---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import { Image } from 'astro:assets';
import HouseSpecialIcon from '@ui/HouseSpecialIcon.astro';
import matchaLatte from '@images/matcha_latte.png';
import whitePasta from '@images/white_pasta.png';
import type { WithContext, Thing } from 'schema-dts';
import { absoluteUrl } from '@utils/url';

const seo = {
  title: 'Menu - MATES Cafe',
  description:
    'The MATES Cafe menu - coffee, matcha, refreshers, light bites and mains in Tanjong Malim, Perak.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  inLanguage: 'en-US',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'MATES Cafe Menu',
  description:
    'Coffee, matcha, refreshers and fresh kitchen plates at MATES Cafe in Tanjong Malim.',
  isPartOf: {
    '@type': 'WebSite',
    url: absoluteUrl('/'),
    name: 'MATES',
  },
};

type MenuItem = {
  name: string;
  price: string;
  description?: string;
  special?: boolean;
};

type MenuSection = {
  id: string;
  title: string;
  subtitle: string;
  items: MenuItem[];
  addOns?: MenuItem[];
  note?: string;
};

const coffee: MenuSection = {
  id: 'coffee',
  title: 'Coffee',
  subtitle: 'Espresso, local favourites & house specials',
  items: [
    { name: 'Black', price: 'RM 8' },
    { name: 'White', price: 'RM 10' },
    { name: 'Latte Gula Melaka', price: 'RM 12', special: true },
    { name: 'Spanish Latte', price: 'RM 12' },
    { name: 'Mocha', price: 'RM 12' },
    { name: 'Dirty Latte', price: 'RM 12', special: true },
    { name: 'Coffee by Mates', price: 'RM 15', special: true },
    { name: 'Kopi Pagi Malim', price: 'RM 12', special: true },
    { name: 'Zesty Espresso', price: 'RM 12', special: true },
  ],
  addOns: [
    { name: 'Espresso Shot', price: '+ RM 4' },
    { name: 'Oat Milk', price: '+ RM 1' },
    { name: 'Caramel / Hazelnut', price: '+ RM 2' },
  ],
};

const nonCoffee: MenuSection = {
  id: 'non-coffee',
  title: 'Non Coffee',
  subtitle: 'Matcha, chocolate & teh tarik',
  items: [
    { name: 'Matcha Latte', price: 'RM 10' },
    { name: 'Lychee Matcha', price: 'RM 12' },
    { name: 'Strawberry Matcha', price: 'RM 12' },
    { name: 'Seasalt Matcha', price: 'RM 15', special: true },
    { name: 'Chocolate', price: 'RM 10' },
    { name: 'Teh Tarik Mates', price: 'RM 9' },
    { name: 'Banana Matcha Latte', price: 'RM 15' },
  ],
};

const refreshers: MenuSection = {
  id: 'refreshers',
  title: 'Refreshers',
  subtitle: 'Cold, bright & made for warm afternoons',
  items: [
    { name: 'Lychee in Grey', price: 'RM 9', special: true },
    { name: 'Awan Malim', price: 'RM 9', special: true },
    { name: 'Pink Lemonade', price: 'RM 9' },
    { name: 'Lychee Lemonade', price: 'RM 9' },
  ],
};

const sweetTreats: MenuSection = {
  id: 'sweet-treats',
  title: 'Sweet Treats',
  subtitle: "Today's selection",
  items: [],
  note: 'Check out our treats display for the daily selection!',
};

const lightBites: MenuSection = {
  id: 'light-bites',
  title: 'Light Bites',
  subtitle: 'Small plates for sharing',
  items: [
    {
      name: 'Popia Sayur Rangup',
      price: 'RM 8',
      description:
        'Fresh cabbage-filled spring rolls, carefully wrapped and fried to golden perfection. Served with our special homemade Thai sauce, offering the perfect balance of sweet, tangy, and mildly spicy flavours.',
    },
    {
      name: 'Keropok Lekor',
      price: 'RM 9',
      description:
        'Traditional Malaysian fish crackers, crispy on the outside and chewy on the inside, served hot with sweet and spicy dipping sauce.',
    },
    {
      name: 'Golden Fries',
      price: 'RM 9',
      description:
        'Golden crispy fries, perfectly seasoned and served hot for the ultimate satisfying crunch.',
    },
    {
      name: 'Popcorn Chicken',
      price: 'RM 9',
      description:
        'Crispy popcorn chicken served with mayonnaise and chilli sauce on the side.',
    },
    {
      name: 'Popcorn Chicken Cheesy Fries',
      price: 'RM 14',
      description:
        'Crispy popcorn chicken and golden fries topped with rich, creamy cheese sauce for the perfect cheesy bite.',
    },
  ],
};

const mains: MenuSection = {
  id: 'mains',
  title: 'Mains',
  subtitle: 'Hearty plates from the kitchen',
  items: [
    {
      name: 'Kolok Mee Chicken Popcorn',
      price: 'RM 12',
      special: true,
      description:
        'Springy kolok mee tossed in a light savoury sauce, topped with crispy chicken popcorn for the perfect crunch in every bite.',
    },
    {
      name: 'Kolok Mee Ayam Merah',
      price: 'RM 13',
      special: true,
      description:
        'Springy kolok mee tossed in a light savoury sauce, served with red chicken slices, topped with crispy fried onions and spring onion for a delicious savoury and aromatic finish.',
    },
    {
      name: 'White Beef Pasta',
      price: 'RM 14',
      description:
        'Creamy white sauce pasta tossed with chopped beef steak, garlic and herbs, finished with parmesan for a rich and savoury bite.',
    },
    {
      name: 'Creamy Red Meatball Pasta',
      price: 'RM 12',
      description:
        'Creamy red sauce pasta with juicy meatballs, fresh baby spinach, pea sprouts, daikon pickle and a drizzle of green oil.',
    },
    {
      name: 'Buttermilk Chicken Pasta',
      price: 'RM 14',
      description:
        'Creamy buttermilk sauce tossed with tender chicken and pasta for a rich, savoury, and satisfying bite.',
    },
  ],
};

const menuSections: MenuSection[] = [
  coffee,
  nonCoffee,
  refreshers,
  sweetTreats,
  lightBites,
  mains,
];
---

<BaseLayout seo={seo} schema={schema}>
  {/* Hero */}
  <section class="mx-auto max-w-[85rem] px-4 pt-48 pb-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl font-light text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl">
        Our Menu
      </h1>
      <p class="mt-6 text-lg text-pretty text-slate-600">
        Coffee, matcha, refreshers and fresh plates from the MATES kitchen.
        Every item is made with care by the MATES team.
      </p>
      <nav
        class="mt-8 flex flex-wrap justify-center gap-2"
        aria-label="Menu sections"
      >
        {menuSections.map(section => (
          <a
            href={`#${section.id}`}
            class="rounded-full border border-slate-300 px-5 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-matcha-600 hover:bg-matcha-50 hover:text-matcha-800"
          >
            {section.title}
          </a>
        ))}
      </nav>
      <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-matcha-50 px-4 py-2 text-xs font-semibold tracking-[0.18em] text-matcha-700 uppercase ring-1 ring-matcha-100">
        <HouseSpecialIcon class="size-4" />
        House specials
      </p>
    </div>
  </section>

  {/* A small taste of the cafe */}
  <section
    aria-label="A taste of MATES"
    class="mx-auto max-w-[85rem] px-4 pb-14 sm:px-6 lg:px-8"
  >
    <div class="mx-auto grid max-w-5xl gap-4 sm:grid-cols-2">
      <figure class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-900/5">
        <Image
          src={matchaLatte}
          alt="A MATES matcha latte being finished with a dusting of matcha"
          width={900}
          height={675}
          class="aspect-[4/3] w-full object-cover"
        />
        <figcaption class="flex items-center justify-between gap-4 px-5 py-4">
          <span class="font-medium text-slate-800">Matcha, made proper</span>
          <span class="text-xs font-semibold tracking-[0.16em] text-matcha-700 uppercase">
            From the bar
          </span>
        </figcaption>
      </figure>
      <figure class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-900/5">
        <Image
          src={whitePasta}
          alt="A plate of creamy pasta at MATES Cafe"
          width={900}
          height={675}
          class="aspect-[4/3] w-full object-cover"
        />
        <figcaption class="flex items-center justify-between gap-4 px-5 py-4">
          <span class="font-medium text-slate-800">Pasta, made with care</span>
          <span class="text-xs font-semibold tracking-[0.16em] text-matcha-700 uppercase">
            From the kitchen
          </span>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* Menu Sections */}
  <section class="bg-matcha-50/40 py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="columns-1 gap-6 lg:columns-2">
        {menuSections.map(section => (
          <article
            id={section.id}
            class="mb-6 break-inside-avoid rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-900/5 sm:p-8"
          >
            <p class="text-xs font-semibold tracking-[0.2em] text-matcha-600 uppercase">
              {section.subtitle}
            </p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-800 sm:text-3xl">
              {section.title}
            </h2>

            {section.items.length > 0 && (
              <ul class="mt-6 divide-y divide-dashed divide-slate-200">
                {section.items.map(item => (
                  <li class="flex items-start justify-between gap-5 py-4 first:pt-0 last:pb-0">
                    <div class="min-w-0">
                      <p class="font-medium text-slate-800">
                        {item.name}
                        {item.special && (
                          <span
                            class="ml-1.5 inline-flex translate-y-0.5 text-matcha-600"
                            title="House special"
                          >
                            <HouseSpecialIcon class="size-3.5" />
                            <span class="sr-only">House special</span>
                          </span>
                        )}
                      </p>
                      {item.description && (
                        <p class="mt-1 text-sm leading-relaxed text-slate-500">
                          {item.description}
                        </p>
                      )}
                    </div>
                    <span class="shrink-0 pt-0.5 text-sm font-semibold text-matcha-700 sm:text-base">
                      {item.price}
                    </span>
                  </li>
                ))}
              </ul>
            )}

            {section.addOns && (
              <div class="mt-6 rounded-2xl bg-matcha-50/80 p-5 ring-1 ring-matcha-100">
                <h3 class="text-xs font-semibold tracking-[0.2em] text-matcha-700 uppercase">
                  Add-ons
                </h3>
                <ul class="mt-3 space-y-2">
                  {section.addOns.map(addOn => (
                    <li class="flex items-baseline justify-between gap-4 text-sm">
                      <span class="text-slate-600">{addOn.name}</span>
                      <span class="shrink-0 font-semibold text-matcha-700">
                        {addOn.price}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {section.note && (
              <div class="mt-6 rounded-2xl bg-mates-blue-50 p-5 text-sm leading-relaxed text-slate-600 ring-1 ring-mates-blue-100">
                {section.note}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Note */}
  <section class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl rounded-2xl bg-mates-blue-50 p-8 text-center ring-1 ring-mates-blue-100">
      <p class="text-slate-600">
        Prices are in Malaysian Ringgit (RM) and subject to change. Ask our team
        about daily specials, seasonal drinks and treats.
      </p>
    </div>
  </section>
</BaseLayout>
