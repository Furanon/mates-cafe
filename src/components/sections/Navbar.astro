---
import MegaMenu from '@megaMenu/MegaMenu.astro';
import Button from '@ui/Button.astro';
import InstagramIcon from '@ui/InstagramIcon.astro';
import { Image } from 'astro:assets';
import logoMark from '@images/mates-mark.png';
import { menuList, navigationLinks } from '@/navigation';
import { site } from '@/site';
import { withBase, withoutBase } from '@utils/url';

const currentPath = withoutBase(Astro.url.pathname);

// Call-to-action configuration for the primary button
const primaryCTA = {
  text: 'Visit Us',
  href: withBase('/contact'),
};
---

<header class="fixed inset-x-0 top-5 z-50 mx-auto flex w-full max-w-sm flex-wrap rounded-2xl border-b border-slate-100 p-4 shadow-sm [-webkit-backdrop-filter:blur(16px)] [backdrop-filter:blur(16px)] ring-1 ring-slate-900/5 sm:w-[calc(100%-2rem)] sm:max-w-xl md:max-w-4xl md:flex-nowrap md:justify-start lg:max-w-5xl xl:max-w-6xl xl:shadow-none xl:ring-mates-blue-950/5 2xl:max-w-[81rem]">
  <!-- Keep the tint on its own layer: Safari can paint a translucent background on a backdrop-filtered element as solid white. -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 rounded-2xl bg-white/80 bg-linear-to-t/oklch from-matcha-100/80 via-transparent to-white/80 2xl:via-0%"
  ></div>

  <nav class="relative mx-auto flex w-full flex-wrap items-center justify-between gap-x-2 px-4 py-2 sm:px-6 lg:flex-nowrap lg:gap-3 lg:px-8 xl:max-w-7xl 2xl:max-w-[85rem]">
    <a
      class="dm-sans flex shrink-0 items-center gap-2.5 focus:opacity-80 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-matcha-700/80 focus-visible:ring-offset-2"
      href={withBase('/')}
      aria-label="MATES Logo"
      translate="no"
    >
      <Image
        src={logoMark}
        alt=""
        width={40}
        height={40}
        class="h-9 w-9 object-contain sm:h-10 sm:w-10"
      />
      <span class="text-2xl font-bold tracking-tight text-mates-blue-600">
        MATES
      </span>
    </a>

    <div
      id="hs-header-base"
      class="hs-collapse order-last hidden w-full basis-full overflow-hidden transition-all duration-300 lg:order-none lg:ml-8 lg:block lg:w-auto lg:flex-1 lg:basis-auto 2xl:ml-12"
      aria-labelledby="hs-header-base-collapse"
    >
      <div class="max-h-[75vh] overflow-hidden overflow-y-auto [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-slate-300 [&::-webkit-scrollbar-track]:bg-slate-100">
        <div class="flex flex-col gap-0.5 py-2 lg:flex-row lg:items-center lg:gap-1 lg:py-0">
          <div class="grow">
            <div class="flex flex-col gap-0.5 lg:flex-row lg:items-center lg:justify-evenly lg:gap-1">
              <a
                href={withBase('/')}
                class={`flex items-center rounded-lg p-2 font-medium text-slate-800 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden ${
                  currentPath === '/' ? 'underline underline-offset-4' : ''
                }`}
                aria-current={currentPath === '/' ? 'page' : undefined}
              >
                Home
              </a>

              {menuList.map(menu => (
                <MegaMenu menu={menu} />
              ))}

              {navigationLinks.map(link => (
                <a
                  href={withBase(link.href)}
                  class={`flex items-center rounded-lg p-2 font-medium text-slate-800 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden ${
                    currentPath === link.href
                      ? 'underline underline-offset-4'
                      : ''
                  }`}
                  aria-current={currentPath === link.href ? 'page' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden min-[380px]:flex items-center gap-1.5 rounded-lg p-2 font-medium text-slate-800 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-matcha-700/80"
        aria-label="Follow us on Instagram"
      >
        <InstagramIcon class="size-5" />
        <span class="hidden sm:inline">@mates.officials</span>
      </a>

      <Button
        href={primaryCTA.href}
        variant="primary"
        className="inline-flex h-9 items-center justify-center rounded-full border-none bg-matcha-500 px-4! py-0! text-sm font-semibold text-nowrap text-matcha-950 transition-colors hover:bg-matcha-400 focus:bg-matcha-400 max-[359px]:hidden"
      >
        {primaryCTA.text}
      </Button>

      <button
        type="button"
        class="hs-collapse-toggle relative flex h-9 items-center justify-center gap-1.5 rounded-full border border-slate-200 px-2.5 text-sm font-medium text-slate-800 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-matcha-700/80 sm:px-3 lg:hidden"
        id="hs-header-base-collapse"
        aria-expanded="false"
        aria-controls="hs-header-base"
        aria-label="Toggle navigation"
        data-hs-collapse="#hs-header-base"
      >
        <svg
          class="hs-collapse-open:hidden size-4"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" x2="21" y1="6" y2="6"></line>
          <line x1="3" x2="21" y1="12" y2="12"></line>
          <line x1="3" x2="21" y1="18" y2="18"></line>
        </svg>
        <svg
          class="hs-collapse-open:block hidden size-4 shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
        <span class="hidden sm:block hs-collapse-open:hidden">Menu</span>
        <span class="hidden sm:hs-collapse-open:block">Close</span>
        <span class="sr-only sm:hidden">Toggle navigation</span>
      </button>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', async () => {
    const { HSStaticMethods } = await import('preline');
    HSStaticMethods.autoInit();
  });
</script>
