---
import { Image } from 'astro:assets';
import { withBase } from '@utils/url';
import matchaLatte from '@images/matcha_latte.png';
import groupshot from '@images/groupshot.png';
import community1 from '@images/community1.jpeg';

const communityPoints = [
  'In the heart of Tanjong Malim, Perak',
  'A warm, inclusive space — everyone is welcome',
  'Locally-sourced ingredients and low-waste habits',
  'Free WiFi for studying and remote work',
  'Pet-friendly outdoor seating',
  'Student-friendly prices, always',
];
---

<section class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
  {/* Section heading */}
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-matcha-600">
      Why we exist
    </p>
    <h2 class="mt-3 text-3xl font-semibold text-balance text-slate-800 md:text-4xl">
      More than a cafe. A place to belong.
    </h2>
    <p class="mt-4 text-lg text-pretty text-slate-600">
      MATES is a community hub where students gain real skills, local artists
      find a stage, and everyone finds a seat at the table.
    </p>
  </div>

  {/* Feature cards */}
  <div class="mt-14 grid gap-6 lg:grid-cols-2">
    {/* Signature matcha — the hero feature */}
    <article class="grid overflow-hidden rounded-3xl bg-matcha-50 md:grid-cols-2 lg:col-span-2">
      <div class="order-2 flex flex-col justify-center p-8 sm:p-12 md:order-1">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-matcha-700">
          The MATES signature
        </p>
        <h3 class="mt-3 text-3xl font-semibold text-slate-800">
          Matcha, made properly
        </h3>
        <p class="mt-4 text-pretty text-slate-600">
          We whisk premium Japanese matcha to order, then pair it with silky
          milk, espresso, or fresh strawberry. Order it hot or over ice — either
          way it is the drink people come back for.
        </p>
        <a
          href={withBase('/menu#non-coffee')}
          class="mt-6 inline-flex items-center gap-2 font-semibold text-matcha-700 transition-colors hover:text-matcha-800"
        >
          Explore the matcha menu
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="order-1 min-h-72 md:order-2">
        <Image
          src={matchaLatte}
          alt="A MATES matcha latte being finished with a dusting of matcha"
          width={900}
          height={1100}
          class="h-full w-full object-cover"
        />
      </div>
    </article>

    {/* Volunteer program */}
    <article class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-900/5">
      <Image
        src={groupshot}
        alt="MATES student volunteers behind the counter"
        width={1000}
        height={640}
        class="aspect-[16/10] w-full object-cover"
      />
      <div class="p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-matcha-600">
          For students
        </p>
        <h3 class="mt-2 text-2xl font-semibold text-slate-800">
          Volunteer, and learn to be a barista
        </h3>
        <p class="mt-3 text-pretty text-slate-600">
          Give your time behind the bar and we will teach you the craft:
          espresso, milk steaming, latte art, and customer service. No
          experience needed — just curiosity.
        </p>
        <a
          href={withBase('/community#volunteer')}
          class="mt-5 inline-flex items-center gap-2 font-semibold text-matcha-700 transition-colors hover:text-matcha-800"
        >
          Join the programme
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>

    {/* Art space */}
    <article class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-900/5">
      <Image
        src={community1}
        alt="A community gathering in the MATES art space"
        width={1000}
        height={640}
        class="aspect-[16/10] w-full object-cover"
      />
      <div class="p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-mates-blue-600">
          For artists & makers
        </p>
        <h3 class="mt-2 text-2xl font-semibold text-slate-800">
          An art space, twice a month
        </h3>
        <p class="mt-3 text-pretty text-slate-600">
          Two weekends a month, the cafe becomes a gallery and marketplace.
          Local artists and craftspeople show and sell their work — with no fees
          and no commission.
        </p>
        <a
          href={withBase('/community#art-space')}
          class="mt-5 inline-flex items-center gap-2 font-semibold text-mates-blue-700 transition-colors hover:text-mates-blue-800"
        >
          See the art space
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>
  </div>

  {/* Community principles */}
  <div class="mt-6 rounded-3xl bg-mates-blue-50 p-8 sm:p-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-12">
      <div class="lg:w-1/3">
        <h3 class="text-2xl font-semibold text-slate-800">Community first</h3>
        <p class="mt-2 text-pretty text-slate-600">
          The small things that make MATES feel like yours.
        </p>
      </div>
      <ul class="grid flex-1 gap-3 sm:grid-cols-2">
        {communityPoints.map(point => (
          <li class="flex items-start gap-3 text-slate-700">
            <span
              class="mt-1.5 size-1.5 shrink-0 rounded-full bg-matcha-500"
              aria-hidden="true"
            ></span>
            {point}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
